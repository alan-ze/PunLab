# --- PIXI ---
# Ignore the environment itself (binaries, libs)
.pixi/
# CRITICAL: Do NOT ignore pixi.lock or pyproject.toml
# (They are not listed here, so they will be tracked correctly!)

# --- PYTHON ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.log
# Plotly/Bokeh/HTML outputs often generated by scripts
*.html

# --- MATLAB ---
*.asv
*.mex*
*.slxc
# Ignore .mat files (usually data).
# If you need to commit a small one, use: git add -f file.mat
*.mat

# --- DATA ---
# Ignore contents, but keep folder structure for collaborators
# Raw Data
**/data/raw/*
!**/data/raw/.gitkeep

# Processed Data
**/data/processed/*
!**/data/processed/.gitkeep

# Final Data
**/data/external/*
!**/data/external/.gitkeep
# Ignore local database files if you use SQLite
*.db
*.sqlite3

# --- OS & EDITOR JUNK ---
# Mac
.DS_Store
# Windows
Thumbs.db
# VS Code (Optional: remove if you want to share settings)
.vscode/

# --- LEGACY ENVIRONMENTS ---
# (Good to keep these to prevent accidents if you switch tools)
.env
.venv
env/
venv/